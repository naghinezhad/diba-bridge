# این فایل را کپی کنید:  cp .env.example .env

# ---------- امنیت (حتماً عوض کنید) ----------
# رمز ورود به داشبورد. اگر خالی باشد، بار اول با «کد راه‌اندازی» از لاگ سرور ساخته می‌شود.
ADMIN_PASSWORD=change-me-please
# توکن اتصال کلاینت‌های MCP. خالی = خودکار ساخته و در داشبورد نمایش داده می‌شود.
# MCP_TOKEN=

# ---------- محدودیت‌ها (اختیاری) ----------
# MCP_RATE_LIMIT=120        # درخواست به /mcp در دقیقه برای هر IP
# MCP_WRITE_LIMIT=30        # ابزارهای ارسالی از طرف مدل در دقیقه
# LOG_RETENTION_DAYS=14
# UPSTREAM_TIMEOUT_MS=20000
# ALLOW_PRIVATE_MEDIA_URLS=false   # اجازه‌ی دانلود عکس/فایل از آدرس‌های داخلی

# ---------- شبکه ----------
# اجرای بدون داکر:
PORT=3790
HOST=127.0.0.1
DATA_DIR=./data

# فقط برای docker compose:
#   127.0.0.1 = فقط از خود سرور (دسترسی با تونل SSH) — امن‌تر
#   0.0.0.0   = باز روی IP عمومی (فقط برای تست کوتاه)
BIND_ADDR=127.0.0.1
PUBLIC_PORT=3790

# با دامنه و HTTPS (docker compose --profile https up -d):
# DOMAIN=mcp.example.com
# TRUST_PROXY=1

# ---------- پراکسی به ایران (اگر سرور خارج از ایران به APIها نرسید) ----------
# تونل SSH به سرور ایران روی خود سرور آلمان (DEPLOY.md):
# SOCKS_PROXY=socks5://host.docker.internal:1080
# یا پراکسی HTTP:
# HTTPS_PROXY=http://user:pass@iran-server-ip:3128
# NO_PROXY=localhost,127.0.0.1,api.ipify.org

# ---------- پیام‌رسان‌ها (اختیاری؛ می‌شود از داشبورد هم تنظیم کرد) ----------
# مقدار env بر داشبورد اولویت دارد و آنجا قفل نمایش داده می‌شود.
# *_RECEIVE=true: دریافت خودکار پیام‌ها (صفحه‌ی «پیام‌های دریافتی»)
# BALE_ENABLED=true
# BALE_TOKEN=
# BALE_DEFAULT_CHAT_ID=
# BALE_RECEIVE=true

# بله با حساب کاربری (کلاینت غیررسمی) — نشست را از دکمه‌ی «ورود با حساب بله» بردارید
# BALE_CLIENT_ENABLED=true
# BALE_CLIENT_PHONE=989121234567
# BALE_CLIENT_SESSION=123456:eyJhbGciOi...
# BALE_CLIENT_BASE_URL=https://next-ws.bale.ai
# BALE_CLIENT_WS_URL=wss://next-ws.bale.ai/ws/
# BALE_CLIENT_DEFAULT_CHAT_ID=
# BALE_CLIENT_RECEIVE=true

# EITAA_ENABLED=true
# EITAA_TOKEN=
# EITAA_DEFAULT_CHAT_ID=

# ایتا با حساب کاربری از طریق پل محلی EitaaBun — docs/EITAA_CLIENT_BRIDGE.md
# EITAA_CLIENT_ENABLED=true
# EITAA_CLIENT_BRIDGE_URL=http://127.0.0.1:1234
# EITAA_CLIENT_PHONE=+989121234567
# EITAA_CLIENT_SESSION={"phone":"+989121234567","imei":"...","token":"..."}
# EITAA_CLIENT_WEBHOOK_URL=http://127.0.0.1:3790/api/eitaa-bridge/webhook
# EITAA_CLIENT_WEBHOOK_SECRET=diba-eitaa
# EITAA_CLIENT_DEFAULT_CHAT_ID=
# EITAA_CLIENT_RECEIVE=true

# RUBIKA_ENABLED=true
# RUBIKA_TOKEN=
# RUBIKA_BASE_URL=https://botapi.rubika.ir/v3

# روبیکا با حساب کاربری (کلاینت غیررسمی) — نشست را از دکمه‌ی «ورود با حساب روبیکا» بردارید
# RUBIKA_CLIENT_ENABLED=true
# RUBIKA_CLIENT_PHONE=09121234567
# RUBIKA_CLIENT_SESSION={"phone":"09121234567","auth":"...","guid":"u0...","agent":"...","private_key":"..."}
# RUBIKA_CLIENT_DEFAULT_CHAT_ID=
# RUBIKA_CLIENT_RECEIVE=true

# SOROUSH_ENABLED=true
# SOROUSH_TOKEN=
# SOROUSH_DEFAULT_CHAT_ID=

# سروش‌پلاس با حساب کاربری (MTProto خصوصی) — نشست را از دکمه‌ی «ورود با حساب سروش‌پلاس» بردارید
# SOROUSH_CLIENT_ENABLED=true
# SOROUSH_CLIENT_PHONE=+989121234567
# SOROUSH_CLIENT_SESSION=1BVtsOK...
# SOROUSH_CLIENT_DEFAULT_CHAT_ID=
# SOROUSH_CLIENT_RECEIVE=true

# دیبا روتر (اتصال دستیار و مدل‌های داشبورد) — https://dibarouter.ir/docs
# DIBAROUTER_API_KEY=sk-dc-v1-...
# DIBAROUTER_BASE_URL=https://dibarouter.ir/api/v1
# DIBAROUTER_MODEL=dibachain/diba-router-free
