{
  "name": "diba-mcp",
  "version": "5.0.0",
  "description": "MCP server for Iranian messengers and social services (Bale, Eitaa, Rubika, Soroush Plus, Telegram, WhatsApp, Instagram, X, LinkedIn) and WordPress, with a built-in Persian dashboard",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "iran",
    "persian",
    "bale",
    "eitaa",
    "rubika",
    "soroush",
    "dashboard",
    "ai",
    "wordpress",
    "telegram",
    "whatsapp",
    "dibachain"
  ],
  "homepage": "https://github.com/Dibachain-Company/diba-bridge#readme",
  "bugs": {
    "url": "https://github.com/Dibachain-Company/diba-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dibachain-Company/diba-bridge.git"
  },
  "license": "MIT",
  "author": "Yuness",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "diba-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "vendor",
    "public",
    "docs",
    "scripts",
    "README.md",
    "DEPLOY.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "npm run build && node --watch-path=dist dist/main.js",
    "dev:tsx": "tsx watch src/main.ts",
    "stdio": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:stdio": "node dist/stdio.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "netcheck": "tsx src/netcheck.ts",
    "test:unit": "node scripts/test-unit.mjs",
    "test:e2e": "tsx test/e2e.ts",
    "cli": "tsx src/cli.ts",
    "eitaa:bridge": "node scripts/eitaa-bridge.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "agent-twitter-client": "^0.0.18",
    "express": "^5.3.0",
    "https-proxy-agent": "^9.1.0",
    "instagram-private-api": "^1.46.1",
    "instagrapi-js": "^1.0.12",
    "protobufjs": "7.6.6",
    "qrcode": "^1.5.4",
    "rubjs": "3.2.4",
    "socks-proxy-agent": "^10.1.0",
    "sroosh": "1.0.1",
    "telegram": "^2.26.22",
    "undici": "^8.12.4",
    "ws": "8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "8.5.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
